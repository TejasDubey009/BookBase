{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/kiosk",
      "destination": "/kiosk/index.html"
    },
    {
      "source": "/student",
      "destination": "/student/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": ".*kiosk.*"
        }
      ],
      "destination": "/kiosk/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": ".*student.*"
        }
      ],
      "destination": "/student/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": ".*admin.*"
        }
      ],
      "destination": "/admin/index.html"
    },
    {
      "source": "/",
      "destination": "/kiosk/index.html"
    }
  ]
}

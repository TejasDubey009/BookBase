{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?__path__="
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=$1"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py?__path__=docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py?__path__=openapi.json"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": ".*kiosk.*"
        }
      ],
      "destination": "/kiosk/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": ".*student.*"
        }
      ],
      "destination": "/student/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": ".*admin.*"
        }
      ],
      "destination": "/admin/index.html"
    },
    {
      "source": "/",
      "destination": "/kiosk/index.html"
    }
  ]
}

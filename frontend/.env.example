# Copy this file to frontend/.env and fill it in. frontend/.env is never committed.
# Both values are in your Supabase project: press Connect, then choose App Frameworks.

# The project's URL, such as https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The anon (public) key. It is meant to be in the browser: on its own it can only call the
# database functions that BookBase grants to visitors. Never put the service_role key here.
VITE_SUPABASE_ANON_KEY=

{
  "name": "bookbase-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cd .. && python3 run.py",
    "dev:kiosk": "vite --mode kiosk",
    "dev:student": "vite --mode student",
    "dev:admin": "vite --mode admin",
    "clean": "node -e \"import('node:fs').then((fs) => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && vite build --mode kiosk && vite build --mode student && vite build --mode admin",
    "preview:kiosk": "vite preview --mode kiosk",
    "preview:student": "vite preview --mode student",
    "preview:admin": "vite preview --mode admin"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}

# Copy this file to backend/.env and fill it in. backend/.env is never committed.

# The Supabase connection string. In your Supabase project, press Connect and copy the
# "Transaction pooler" URI, then put your database password in place of [YOUR-PASSWORD].
# If the password contains symbols such as @ or /, URL-encode them.
# Leave this blank to use a local SQLite file instead, which needs no setup.
DATABASE_URL=

# The password for the seeded librarian account, ADMIN001.
# If blank, one is generated when the database is first seeded, and printed once in the terminal.
BOOKBASE_ADMIN_PASSWORD=

# Whoever knows this code can sign up as library staff on the admin portal.
# If blank, nobody can.
BOOKBASE_STAFF_SIGNUP_CODE=

# 1 lists the seeded student accounts on the sign-in form, for demos. Librarians are never listed.
BOOKBASE_DEMO_MODE=1

# Signs login sessions. Optional locally, where a random one is used if this stays commented out.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# BOOKBASE_SECRET_KEY=

# Students can only borrow, or raise returns, through a kiosk holding this key. Optional locally, where run.py makes one
# for each run and gives it to the kiosk site if this stays commented out.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# BOOKBASE_KIOSK_KEY=
